# Public site URL – used for canonical URLs, sitemap, Open Graph and schema.
# [CONFIRM] replace with the real domain before launch.
NEXT_PUBLIC_SITE_URL=https://www.bsbhealthcare.in

# [CONFIRM] GA4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=

# Optional search-console verification tokens (the content="…" value from Google / Bing)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
